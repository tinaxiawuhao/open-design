# Extends the official image with libc6-compat so glibc-linked agent CLIs
# (Claude Code, Codex, host-mounted opencode, …) can run on Alpine musl.
# opencode is bundled in the official image as a musl build; this layer is
# for CLIs that are mounted from the host instead.
# See README.md "Linux: mounting host agent CLIs" for usage.
FROM ghcr.io/nexu-io/od:latest

USER root
RUN apk add --no-cache libc6-compat
USER open-design
